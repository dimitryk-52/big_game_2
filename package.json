{
  "name": "big-game-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:map": "python scripts/build-map.py",
    "build:bgs": "python scripts/pixelart.py --bgs",
    "sim": "tsx scripts/sim.ts",
    "check:supabase": "node scripts/check-supabase.mjs",
    "local": "vite build && vite preview --port 4173 --strictPort --open /tv.html",
    "local:admin": "vite build && vite preview --port 4173 --strictPort --open /admin.html",
    "pixelart": "node tools/pixelart/server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pixi.js": "^8.22.0",
    "preact": "^11.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
