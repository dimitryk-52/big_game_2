# Скопируй в .env и заполни, чтобы работать через Supabase.
# Без этих переменных игра работает через локальный dev-ретранслятор (npm run dev).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Адрес опубликованного сайта (GitHub Pages). Нужен, если ТВ запускается локально:
# QR-код поведёт телефоны сюда, а не на localhost.
VITE_PUBLIC_URL=https://ЛОГИН.github.io/РЕПОЗИТОРИЙ/

# Ключ Google AI Studio для генератора пиксель-арта (tools/pixelart, «Пиксель-арт.bat»).
# Без префикса VITE_ — чтобы ключ не попал в сборку игры.
GEMINI_API_KEY=
